# Copy to .env or export these variables in your shell when using live LLM APIs.

# OpenAI or OpenAI-compatible chat-completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Generic OpenAI-compatible local/server endpoint, for example vLLM, LM Studio, or compatible gateways
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama local chat endpoint
OLLAMA_BASE_URL=http://localhost:11434
